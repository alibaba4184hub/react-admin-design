VITE_NODE_ENV = localhost
# 接口请求域名
VITE_BASE_URL = https://www.ys69.com
# VITE_BASE_URL = http://192.168.1.81:9093
# VITE_BASE_URL = http://192.168.100.127:9093
# 接口全局业务请求后缀
VITE_REQUEST_URL_PREFIX = /adminapi
# 后台地址基础目录 比如想访问后台的地址为：https://demo.tigshop.cn/admin/ 时可以填 /admin
VITE_BASE_DIR = admin
VITE_SOCKET_URL = 

# 是否多商户
VITE_IS_MERCHANT = 1
# 是否Pro版本
VITE_IS_PRO = 1
# 是否跨境
VITE_IS_OVERSEAS = 0
# 是否B2B
VITE_IS_B2B = 1
# 是否S2B2C
VITE_IS_VENDOR = 1